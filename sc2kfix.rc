IDD_INSTALL DIALOGEX 0, 0, 309, 200
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "SimCity 2000 Installation (sc2kfix)"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "OK",ID_INSTALL_OK,130,180,50,14
    CTEXT           "SimCity 2000 / sc2kfix needs some information to run on this computer.\nYou can change these at any time in the sc2kfix Settings dialog in-game.",IDC_STATIC,13,44,282,21
    EDITTEXT        IDC_EDIT_MAYOR,117,92,167,14,ES_CENTER | ES_AUTOHSCROLL
    CTEXT           "Default Mayor Name",IDC_STATIC,24,95,84,8
    LTEXT           "Welcome to sck2fix!",IDC_STATIC_INSTALL_BANNER,136,19,87,18
    ICON            IDI_TOPSECRET,IDC_STATIC_TOPSECRET,86,1,20,20,SS_REALSIZEIMAGE,WS_EX_TRANSPARENT
    GROUPBOX        "Registration Settings",IDC_STATIC,7,81,294,33
    GROUPBOX        "Default Gameplay Settings",IDC_STATIC,7,121,294,54
    CONTROL         "  Configure sc2kfix with all enhancements, bug fixes, and mod support (enhanced)",IDC_RADIO_INSTALL_FULL,
                    "Button",BS_AUTORADIOBUTTON,17,133,278,10
    CONTROL         "  Configure sc2kfix with basic enhancements, bug fixes, and mod support (vanilla+)",IDC_RADIO_INSTALL_BASIC,
                    "Button",BS_AUTORADIOBUTTON,17,146,278,10
    CONTROL         "  Configure sc2kfix with only critical bug fixes and no enhancements (vanilla)",IDC_RADIO_INSTALL_VANILLA,
                    "Button",BS_AUTORADIOBUTTON,17,159,278,10
    CTEXT           "Hover over an option for more information.",IDC_STATIC,13,65,282,8
END

